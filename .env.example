# P.A.R.C.E — variables de entorno
# Copia este archivo como .env para desarrollo local. En Render (o cualquier
# servidor) se configuran como variables de entorno y el .env no hace falta.

# Aplicación
APP_NAME="P.A.R.C.E"
APP_ENV=local                     # production en servidores
APP_DEBUG=true                    # false en producción (oculta detalles de errores)
APP_URL=http://localhost:5173     # URL pública del sitio; se usa para los enlaces de archivos subidos y de recuperación de contraseña
APP_TIMEZONE=America/Bogota

# Base de datos MySQL / MariaDB
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parce
DB_USERNAME=root
DB_PASSWORD=
# DB_SSL_CA=/ruta/al/ca.pem       # solo si el proveedor exige TLS (en Docker/Render usa DB_SSL_CA_PEM con el contenido)

# Sesión (opcionales; los valores por defecto son seguros)
# SESSION_LIFETIME=7200           # segundos
# SESSION_IDLE_TIMEOUT=1800       # segundos de inactividad
# SESSION_COOKIE_SECURE=auto      # auto | true | false

# CORS: solo hace falta si el frontend se sirve desde otro dominio
# CORS_ALLOWED_ORIGINS=https://otro-dominio.com

# Correos de recuperación de contraseña (https://resend.com)
# Sin clave, el endpoint responde normalmente pero no envía el correo.
# RESEND_API_KEY=
# MAIL_FROM="P.A.R.C.E <onboarding@resend.dev>"

# CAPTCHA con Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile).
# Sin las dos claves el CAPTCHA se omite. Para probar en local, Cloudflare
# publica claves de prueba que siempre aprueban:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Asistente de diagnóstico (https://console.groq.com). La clave vive solo en el servidor.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant   # opcional

# Carpeta de archivos subidos (por defecto public/uploads)
# UPLOADS_PATH=

# Destino de los logs: "file" escribe en storage/logs/{tipo}-AAAA-MM-DD.log;
# "stderr" los manda a la salida de errores, que es lo que muestra la pestaña
# Logs de Render. Si no se define: stderr con APP_ENV=production, file si no.
# LOG_CHANNEL=file

# Solo si la app está detrás de un proxy propio: IPs autorizadas a enviar X-Forwarded-For
# TRUSTED_PROXIES=
